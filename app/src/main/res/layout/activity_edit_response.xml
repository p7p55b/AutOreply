<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <EditText
            android:id="@+id/response_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Titre de la réponse"
            android:inputType="text" />

        <EditText
            android:id="@+id/response_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Message de réponse"
            android:inputType="textMultiLine"
            android:minLines="3" />

        <Button
            android:id="@+id/select_apps_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Applications autorisées" />

        <TextView
            android:id="@+id/response_apps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Toutes les applications"
            android:textAppearance="?attr/textAppearanceBody2" />

        <Button
            android:id="@+id/select_triggers_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Critères de déclenchement" />

        <TextView
            android:id="@+id/response_triggers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Aucun critère"
            android:textAppearance="?attr/textAppearanceBody2" />

        <Button
            android:id="@+id/save_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Enregistrer" />
    </LinearLayout>

</ScrollView>