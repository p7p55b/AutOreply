<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/response_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Titre de la réponse"
                android:textAppearance="?attr/textAppearanceHeadline6" />

            <TextView
                android:id="@+id/response_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Résumé du message de réponse"
                android:textAppearance="?attr/textAppearanceBody2" />

            <TextView
                android:id="@+id/response_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Apps : toutes · Critères : aucun"
                android:textAppearance="?attr/textAppearanceCaption" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/delete_button"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_margin="6dp"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="Supprimer"
            android:scaleType="centerInside"
            android:tint="?attr/colorOnSurface"
            android:layout_gravity="end|top" />

    </FrameLayout>

</androidx.cardview.widget.CardView>